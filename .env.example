# bot | userbot | both
MODE=bot

# @BotFather dan
BOT_TOKEN=123456:ABC...
# Haydovchilar guruhi (botni qo'shib, /id yozing)
DRIVERS_CHAT_ID=-1001234567890
# Faqat birinchi ishga tushirishda groups.json ga ko'chiriladi (ixtiyoriy).
# Keyin guruhlar bot orqali boshqariladi: /add, /addgroup, /delgroup, /groups
SOURCE_CHATS=
# Haydovchilar guruhi adminlaridan tashqari bot adminlari (user ID, vergul bilan, ixtiyoriy)
# /agregator "birinchi e'lon" xabarlari shu odamlarga keladi
ADMIN_IDS=

# Userbot uchun: https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=abcdef0123456789
SESSION_NAME=userbot

# Bepul AI (faqat noaniq xabarlar uchun). Bo'sh qoldirsangiz AI ishlatilmaydi.
# Groq: https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Muqobil: OpenRouter -> AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<":free" bilan tugaydigan model>

DEDUP_MINUTES=45
SEND_INTERVAL_SEC=3.2
# Bundan eski xabarlar e'lon qilinmaydi (bot o'chiq bo'lgan vaqtdan qolganlar)
MAX_AGE_MINUTES=15

# Bir yo'lovchi ikki buyurtma orasida kutadigan vaqt (soniya)
ORDER_COOLDOWN_SEC=120
# 1 = manba guruhda yo'lovchi xabariga "Buyurtma berish" tugmasi bilan javob beradi
# (bir odamga kuniga 1 marta). Bot u guruhda yoza olishi kerak.
OFFER_IN_GROUPS=0

# Yo'nalish filtri: 1 = yo'nalishi aniqlanmagan e'lonlar ham maxfiy guruhga tushmaydi.
# 0 = ularni o'tkazadi (e'lon yo'qotmaslik uchun). Yo'nalishlar bot ichida /menu -> Yo'nalishlar
ROUTE_FILTER_STRICT=0

# Userbot agregator/tarqatkich (/agregator). Guruhga shundan tez-tez e'lon yuborilmaydi:
BROADCAST_MIN_INTERVAL_MIN=30
# Kunlik maksimal tarqatish sikli va guruhlar orasidagi pauza (soniya):
BROADCAST_MAX_PER_DAY=20
BROADCAST_GAP_SEC=4

# Sozlama fayllari (ixtiyoriy, standart nomlar ishlatiladi)
MOD_FILE=
USERS_FILE=
ROUTES_FILE=
AGG_FILE=

# CERTIFICATE_VERIFY_FAILED chiqsa 1 qiling: OS sertifikatlari ishlatiladi
USE_SYSTEM_CA=0
